 "calcs": [
  {
   "id": "i_pullup_ma",
   "expr": "3.3 / R('R1') * 1000",
   "unit": "mA",
   "max": 3.0
  },
  {
   "id": "t_rise_10k_50pF_ns",
   "expr": "0.8473 * R('R1') * 50e-12 * 1e9",
   "unit": "ns",
   "max": 1000,
   "note": "100 kHz limit, SBOSAC3B 5.6 has 300 ns at 400 kHz"
  },
  {
   "id": "i_led_ma",
   "expr": "(3.3 - 2.0) / R('R4') * 1000",
   "unit": "mA",
   "min": 0.5,
   "max": 5
  },
  {
   "id": "p_ldo_100ma_w",
   "expr": "(5.5 - 0.3 - 3.3) * 0.1",
   "unit": "W",
   "max": 0.25
  },
  {
   "id": "tj_ldo_c",
   "expr": "60 + p_ldo_100ma_w * 182",
   "unit": "degC",
   "max": 125,
   "note": "RthJA 181.9 K/W SOT-23-5, SBVS277C 6.4, 60 C local ambient"
  },
  {
   "id": "p_pkg_25a_typ_w",
   "expr": "25**2 * 1.0e-3",
   "unit": "W",
   "note": "package 1.0 mOhm typ, 1.3 max, SBOSAC3B 5.5"
  },
  {
   "id": "p_pkg_25a_max_w",
   "expr": "25**2 * 1.3e-3",
   "unit": "W"
  },
  {
   "id": "p_cu_25a_w",
   "expr": "(0.0928 + 0.0986) * 1.15",
   "unit": "W",
   "note": "pcb irdrop IS_P 92.8 mW + IS_N 98.6 mW, x1.15 for copper at about 60 C"
  },
  {
   "id": "theta_evm_kw",
   "expr": "(150 - 60) / (37.5**2 * 1.49e-3)",
   "unit": "K/W",
   "note": "Figure 6-4: 37.5 A at 60 C ambient reaches Tj 150 C on TI's EVM; 1.49 mOhm at 150 C"
  },
  {
   "id": "theta_board_kw",
   "expr": "1 / (15 * 2 * 40e-3 * 25.4e-3)",
   "unit": "K/W",
   "note": "this board, both faces, h 15 W/m2K still air plus radiation"
  },
  {
   "id": "theta_spread_kw",
   "expr": "log(8 / 1.5) / (2 * pi * 385 * 140e-6)",
   "unit": "K/W",
   "vars": {
    "pi": 3.14159
   },
   "note": "radial spread r 1.5 to 8 mm, two 70 um layers"
  },
  {
   "id": "theta_design_kw",
   "expr": "45.0",
   "unit": "K/W",
   "min": 37.0,
   "note": "design value, above both the EVM figure and board + spread"
  },
  {
   "id": "dt_25a_typ_k",
   "expr": "theta_design_kw * (p_pkg_25a_typ_w + p_cu_25a_w) / (1 - theta_design_kw * p_pkg_25a_typ_w * 0.0039)",
   "unit": "K",
   "note": "R rises 0.39 %/K, Figure 6-1"
  },
  {
   "id": "dt_25a_max_k",
   "expr": "theta_design_kw * (p_pkg_25a_max_w + p_cu_25a_w) / (1 - theta_design_kw * p_pkg_25a_max_w * 0.0039)",
   "unit": "K"
  },
  {
   "id": "tj_25a_40c_worst_c",
   "expr": "40 + dt_25a_max_k",
   "unit": "degC",
   "max": 125,
   "note": "rating point: 25 A, 40 C ambient, 1.3 mOhm part"
  },
  {
   "id": "tj_35a_25c_typ_c",
   "expr": "25 + theta_design_kw * (35**2*1.0e-3 + p_cu_25a_w*(35/25)**2) / (1 - theta_design_kw * 35**2*1.0e-3 * 0.0039)",
   "unit": "degC",
   "note": "why the board is not rated 35 A: above 100 C on the copper"
  },
  {
   "id": "v_drop_25a_mv",
   "expr": "25 * 1.0 + 3.87 + 4.10",
   "unit": "mV",
   "note": "package + pcb irdrop on both pours"
  }
 ],
 "bringup": "../../BRINGUP.md",
 "irdrop": {
  "sources": {
   "IS_P": "J4.1",
