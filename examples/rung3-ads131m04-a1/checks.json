 "calcs": [
  {
   "id": "fc_hz",
   "expr": "1 / (2 * 3.14159265 * (R('R1') + R('R2')) * C('C7'))",
   "unit": "Hz",
   "min": 7000,
   "max": 9000,
   "note": "differential RC corner, SBAS890D Figure 9-1 values"
  },
  {
   "id": "fc_over_nyquist_16k",
   "expr": "fc_hz / 8000",
   "min": 0.9,
   "max": 1.1,
   "note": "design data rate 16 kSPS, OSR 256, Nyquist 8 kHz"
  },
  {
   "id": "atten_fmod_db",
   "expr": "10 * log10(1 + (4096000 / fc_hz) ** 2)",
   "unit": "dB",
   "min": 50,
   "note": "single pole at fMOD = 4.096 MHz, the band the digital filter cannot reject"
  },
  {
   "id": "atten_32k_db",
   "expr": "10 * log10(1 + (32000 / fc_hz) ** 2)",
   "unit": "dB",
   "max": 13,
   "note": "signal loss at Nyquist if run at 64 kSPS with the stock 10 nF"
  },
  {
   "id": "fc_wide_hz",
   "expr": "1 / (2 * 3.14159265 * 2000 * 2.2e-9)",
   "unit": "Hz",
   "min": 32000,
   "note": "option: swap C7-C10 to 2.2 nF C0G C33353 for 64 kSPS"
  },
  {
   "id": "gain_err_pct",
   "expr": "100 * (R('R1') + R('R2')) / 330e3",
   "unit": "%",
   "max": 1.0,
   "note": "series R against Zin 330 k at fMOD 4.096 MHz, Equation 4, gain 1 to 4"
  },
  {
   "id": "r_noise_uv",
   "expr": "1e6 * sqrt(4 * 1.38e-23 * 300 * 2000 * 1.57 * fc_hz)",
   "unit": "uVrms",
   "max": 1.0,
   "note": "thermal noise of 2 k over the filter noise bandwidth"
  },
  {
   "id": "ldo_noise_rti_nv",
   "expr": "1000 * 10 * 10 ** (-75 / 20)",
   "unit": "nVrms",
   "max": 5,
   "note": "TPS7A20 10 uVrms at 1 mA, 10 Hz-100 kHz, through AVDD PSRR 75 dB at dc"
  },
  {
   "id": "ldo_margin_vs_adc",
   "expr": "420 / ldo_noise_rti_nv",
   "min": 100,
   "note": "lowest ADC noise in Table 7-1, 0.42 uVrms, over the LDO term"
  },
  {
   "id": "i_3v3_ma",
   "expr": "4.0 + 0.5 + 5.0 + (3.3 - 2.0) / R('R13') * 1000 + 2 * 3.3 / R('R17') * 1000",
   "unit": "mA",
   "max": 20,
   "note": "IAVDD + IDVDD max, YSO110TR 5 mA max, LED, both pull-ups held low"
  },
  {
   "id": "p_ldo_mw",
   "expr": "(5.0 - 3.3) * i_3v3_ma",
   "unit": "mW",
   "max": 100
  },
  {
   "id": "tj_ldo",
   "expr": "85 + p_ldo_mw / 1000 * 200",
   "unit": "degC",
   "max": 125,
   "note": "RthJA DBV 199.6 or 201.4 K/W, table uses 200"
  },
  {
   "id": "fb_drop_mv",
   "expr": "4.0 * 0.45",
   "unit": "mV",
   "max": 5,
   "note": "IAVDD 4 mA through 450 mohm DCR"
  },
  {
   "id": "sclk_min_mhz_64k",
   "expr": "6 * 24 * 64000 / 1e6",
   "unit": "MHz",
   "max": 25,
   "note": "six 24-bit words per frame at 64 kSPS, tc(SC) 40 ns = 25 MHz limit"
  },
  {
   "id": "led_ma",
   "expr": "(3.3 - 2.0) / R('R13') * 1000",
   "unit": "mA",
   "min": 0.5,
   "max": 3
  }
 ],
