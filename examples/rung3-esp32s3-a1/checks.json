  }
 },
 "calcs": [
  {
   "id": "i_3v3_peak_a",
   "expr": "0.340+0.1+0.003+0.003+0.05",
   "unit": "A",
   "max": 0.8,
   "note": "S3 340 mA (DS table 5-7), Qwiic 100 mA, LEDs, 50 mA margin; regulator limit 0.8 A"
  },
  {
   "id": "v_d1_drop",
   "expr": "0.5",
   "unit": "V",
   "max": 0.6,
   "note": "B5819W VF 0.6 V max at 1 A"
  },
  {
   "id": "vin_ldo_min",
   "expr": "4.75-0.05-v_d1_drop",
   "unit": "V",
   "min": 3.75,
   "note": "USB 4.75 V min, 50 mV cable+trace, D1"
  },
  {
   "id": "headroom_min",
   "expr": "vin_ldo_min-3.3",
   "unit": "V",
   "min": 0.28,
   "note": "against the 0.28 V max dropout at 500 mA, DS table"
  },
  {
   "id": "p_ldo_burst",
   "expr": "(5.25-0.35-3.3)*0.6",
   "unit": "W",
   "max": 1.2,
   "note": "USB 5.25 V max, D1 0.35 V, 600 mA"
  },
  {
   "id": "tj_ldo_burst",
   "expr": "40+p_ldo_burst*56",
   "unit": "degC",
   "max": 125,
   "note": "theta_ja TO-252-2 56 K/W SGM2212 DS; SOT-223 at 117 K/W would read 152"
  },
  {
   "id": "tj_sot223_rejected",
   "expr": "40+p_ldo_burst*117",
   "unit": "degC",
   "note": "why not SOT-223"
  },
  {
   "id": "xtal_cl",
   "expr": "C('C15')*C('C16')/(C('C15')+C('C16'))*1e12+2.5",
   "unit": "pF",
   "min": 8.0,
   "max": 10.0,
   "note": "CL 9 pF target, Cstray 2.5 pF estimate, HDG 1.3.5"
  },
  {
   "id": "en_tau_ms",
