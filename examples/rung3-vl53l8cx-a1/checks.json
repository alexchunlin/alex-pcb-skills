 "calcs": [
  {
   "id": "i_avdd_ma",
   "expr": "50+10",
   "unit": "mA",
   "max": 60,
   "note": "DS14161 Table 12 active max + 10 mA peak note"
  },
  {
   "id": "i_1v8_ma",
   "expr": "80+10+0.006+10+2.0",
   "unit": "mA",
   "max": 110,
   "note": "CORE 80+10, IOVDD 10 peak, 1V8 pull-ups: 2x 0.82 mA + 5x 38 uA"
  },
  {
   "id": "i_3v3_ma",
   "expr": "i_avdd_ma+i_1v8_ma+5+1.3",
   "unit": "mA",
   "max": 170,
   "note": "AVDD + 1V8 + host-side pull-ups 5 mA + LED 1.3 mA"
  },
  {
   "id": "p_u2_w",
   "expr": "(5.0-3.3)*i_3v3_ma/1000",
   "unit": "W",
   "max": 0.3,
   "note": "U2 at VIN 5 V"
  },
  {
   "id": "tj_u2",
   "expr": "60+p_u2_w*100.2",
   "unit": "degC",
   "max": 125,
   "note": "TLV755P WSON RthJA 100.2 K/W, 60 C ambient"
  },
  {
   "id": "p_u4_w",
   "expr": "(3.3-1.8)*i_1v8_ma/1000",
   "unit": "W",
   "max": 0.2,
   "note": "U4"
  },
  {
   "id": "tj_u4",
   "expr": "60+p_u4_w*194",
   "unit": "degC",
   "max": 125,
   "note": "LP5907 SOT-23-5 RthJA about 194 K/W"
  },
  {
   "id": "rail_at_vin_3v3",
   "expr": "3.3-0.238*i_3v3_ma/500-0.095*i_3v3_ma/1000",
   "unit": "V",
   "min": 3.13,
   "note": "U2 dropout 238 mV max at 500 mA scaled, U3 95 mOhm; AVDD min 3.13 (Table 10)"
  },
  {
   "id": "rail_at_vin_5v_low",
   "expr": "3.3*0.985-0.095*i_3v3_ma/1000",
   "unit": "V",
   "min": 3.13,
   "note": "U2 1.5 % accuracy, U3 drop"
  },
  {
   "id": "rail_at_vin_5v_high",
   "expr": "3.3*1.015",
   "unit": "V",
   "max": 3.47,
   "note": "AVDD max Table 10"
  },
  {
   "id": "en_delay_ms",
   "expr": "1e3*(R('R1')*1e6/(R('R1')+1e6))*C('C8')*log((3.3*1e6/(R('R1')+1e6))/((3.3*1e6/(R('R1')+1e6))-1.2))",
   "unit": "ms",
   "min": 3.3,
   "max": 10,
   "note": "U4 EN crosses VIH 1.2 V; R1 with internal 1M; must exceed the slowest legal AVDD ramp 3.3 V / 0.001 V/us = 3.3 ms"
  },
  {
   "id": "core_slew_typ",
   "expr": "(0.95*1.8)/80",
   "unit": "V/us",
   "min": 0.012,
   "note": "LP5907 tON 80 us typ to 95 %; Table 5 0.012 V/us"
  },
  {
   "id": "core_0v9_1v6_at_tonmax_us",
   "expr": "150*(1.6-0.9)/(0.95*1.8)",
   "unit": "us",
   "max": 63,
   "note": "Figure 9: 0.9 to 1.6 V in 63 us, linear ramp at tON max 150 us"
  },
  {
   "id": "i2c_tr_ns",
   "expr": "0.8473*R('R12')*30e-12*1e9",
   "unit": "ns",
   "max": 300,
   "note": "host side, 10k, 30 pF, FM limit 300 ns"
  },
  {
   "id": "i2c_1v8_tr_ns",
   "expr": "0.8473*R('R3')*30e-12*1e9",
   "unit": "ns",
   "max": 120,
   "note": "sensor side, 2.2k, 30 pF, DS14161 Table 6 tR 120 ns"
  },
  {
   "id": "miso_tr_ns",
   "expr": "2.2*R('R16')*30e-12*1e9",
   "unit": "ns",
   "max": 120,
   "note": "MISO up-translation at 3 MHz: half period 167 ns"
  },
  {
   "id": "miso_sink_ma",
   "expr": "3.3/R('R16')*1e3",
   "unit": "mA",
   "max": 4.0,
   "note": "Table 15 VOL rated at 4 mA"
  }
 ],
